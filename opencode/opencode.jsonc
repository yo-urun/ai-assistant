{
  "$schema": "https://opencode.ai/config.json",

  // installer:providers — в эту строку-маркер мастер установки вставляет блок "providers" (Ollama/свой endpoint).

  // Модель по умолчанию — из .env, чтобы одна сборка работала с любым
  // провайдером (OpenAI/OpenRouter/Anthropic/Ollama/свой endpoint).
  // Бот задаёт модель сессии сам, из /settings.
  "model": "{env:OPENCODE_MODEL_PROVIDER}/{env:OPENCODE_MODEL_ID}",

  // Агент, который используется, если сессия не выбрала иной.
  "default_agent": "assistant",

  // --- Бюджет контекста (см. docs/token-budget.md) -------------------
  // OpenCode V2 не имеет «sliding window» по числу сообщений: историю
  // ограничивает компакция. Для ассистента в Telegram важен не весь дамп
  // чата, а последние реплики + память в графе.
  //
  // keep.tokens — сколько недавнего разговора оставить рядом со сводкой.
  // buffer      — за сколько токенов до лимита модели начинать компакцию.
  //               Чем больше buffer, тем раньше сжимается история и тем
  //               меньше токенов уходит в каждый следующий запрос.
  // Для модели на 128k: порог ≈ 128k − 96k = 32k. Модели с меньшим
  // контекстом (buffer ≥ лимита) OpenCode игнорирует и сжимает near-limit.
  "compaction": {
    "auto": true,
    "keep": { "tokens": 8000 },
    "buffer": 96000
  },

  // Ограничение вывода инструментов, который попадает в историю. Дефолт
  // (2000 строк / 50 КиБ) для чат-ассистента избыточен: прочитанный файл
  // потом тащится в каждом следующем запросе.
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 16384
  },

  "agents": {
    "assistant": {
      "description": "Персональный ассистент в Telegram",
      "mode": "primary",
      // Промпт короткий и без динамики в начале: дата/окружение, которые
      // добавляет OpenCode, идут в конце системного промпта и не ломают
      // prompt cache. Просим краткость — output тоже стоит денег.
      "system": "Ты — полезный персональный ассистент. Отвечай кратко и по делу: 1–5 предложений, если не просят подробнее. Не пересказывай вопрос и не повторяй уже сказанное. Помни контекст пользователя, используй долговременную память. Не изменяй файлы без необходимости.",
      // Для ассистента-«болталки» запрещаем правку/запись файлов.
      // Это и есть точка кастомизации под конкретного клиента.
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "write", "resource": "*", "effect": "deny" },
        { "action": "patch", "resource": "*", "effect": "deny" }
      ]
    },
    // Сводки компакции пишет дешёвая модель, а не основная. Пустое значение
    // (или неизвестная модель) — OpenCode откатится на модель сессии.
    "compaction": {
      "model": "{env:OPENCODE_SMALL_MODEL}"
    }
  },

  // Фоновый экстрактор памяти (OpenCode V2 -> Graphiti MCP).
  // Установлен в образ по пути /opt/graphiti-extractor; читает GRAPHITI_URL,
  // GRAPHITI_GROUP_ID и параметры батча из окружения (см. .env.example).
  // Захват идёт в фоне, без инъекции в контекст.
  "plugins": ["/opt/graphiti-extractor"],

  "mcp": {
    "servers": {
      "graphiti": {
        "type": "remote",
        "url": "http://graphiti:8000/mcp",
        "oauth": false
      },
      // Индексация кодовой базы: Serena (символ-уровень через LSP, 40+ языков).
      // Выключена по умолчанию — включайте для КРУПНЫХ проектов (docs/code-indexing.md).
      "serena": {
        "type": "local",
        "command": ["uvx", "--from", "git+https://github.com/oraios/serena", "serena", "start-mcp-server", "--context", "ide-assistant"],
        "enabled": false
      }
    }
  }
}
