{
  "$schema": "https://opencode.ai/config.json",

  // Модель по умолчанию. Бот может переопределять её из /settings.
  "model": "openai/gpt-4o-mini",

  // Агент, который используется, если сессия не выбрала иной.
  "default_agent": "assistant",

  "agents": {
    "assistant": {
      "description": "Персональный ассистент в Telegram",
      "mode": "primary",
      "system": "Ты — полезный персональный ассистент. Отвечай кратко и по делу, по-русски. Не изменяй файлы без необходимости.\n\nДолговременная память (Graphiti) — веди её аккуратно:\n- Инструмент `memory`: `search` — вспомнить, `add` — сохранить заметку, `stats`/`organize`/`saga` — обслуживание.\n- Сохраняй проактивно важное: проекты, сайты, договорённости, решения, устойчивые предпочтения.\n- Пиши канонично: одно реальное имя на сущность, без синонимов и дублей (например `my-project`, `Anna`, `acme-api`).\n- Предпочитай конкретные сущности и типизированные связи; избегай расплывчатых «Topic»/«Object», если есть точное имя.\n- Перед сохранением проверь через `search`, не дублируй уже известные факты.",
      // Для ассистента-«болталки» запрещаем правку/запись файлов.
      // Это и есть точка кастомизации под конкретного клиента.
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "write", "resource": "*", "effect": "deny" }
      ]
    }
  },

  // Фоновый экстрактор памяти (OpenCode V2 -> Graphiti MCP).
  // Установлен в образ по пути /opt/graphiti-extractor; читает GRAPHITI_URL и
  // GRAPHITI_GROUP_ID из окружения. Захват идёт в фоне, без инъекции в контекст.
  "plugins": ["/opt/graphiti-extractor"],

  "mcp": {
    "servers": {
      "graphiti": {
        "type": "remote",
        "url": "http://graphiti:8000/mcp",
        "oauth": false
      },
      // Индексация кодовой базы: Serena (символ-уровень через LSP, 40+ языков).
      // Выключена по умолчанию — включайте для КРУПНЫХ проектов (docs/code-indexing.md).
      "serena": {
        "type": "local",
        "command": ["uvx", "--from", "git+https://github.com/oraios/serena", "serena", "start-mcp-server", "--context", "ide-assistant"],
        "enabled": false
      }
    }
  }
}
