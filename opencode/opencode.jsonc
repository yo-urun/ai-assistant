{
  "$schema": "https://opencode.ai/config.json",

  // Модель по умолчанию. Бот может переопределять её из /settings.
  "model": "openai/gpt-4o-mini",

  // Агент, который используется, если сессия не выбрала иной.
  "default_agent": "assistant",

  // Дополнительный провайдер: Google Gemini ("google").
  // Расширяет автономные возможности агента (маркетинг и исследования,
  // текст/изображения, длинный контекст, grounding через Google Search).
  // Ключ берётся из окружения (.env): достаточно ОДНОГО из имён ниже.
  // Получить: https://aistudio.google.com/apikey
  // Модель включается/выбирается в /models (например, google/gemini-2.5-flash).
  "providers": {
    "google": {
      "env": ["GEMINI_API_KEY", "GOOGLE_GENERATIVE_AI_API_KEY", "GOOGLE_API_KEY"]
    }
  },

  "agents": {
    "assistant": {
      "description": "Персональный ассистент в Telegram",
      "mode": "primary",
      "system": "Ты — полезный персональный ассистент. Отвечай кратко и по делу. Помни контекст пользователя, используй долговременную память. Не изменяй файлы без необходимости.",
      // Для ассистента-«болталки» запрещаем правку/запись файлов.
      // Это и есть точка кастомизации под конкретного клиента.
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "write", "resource": "*", "effect": "deny" }
      ]
    }
  },

  // Фоновый экстрактор памяти (OpenCode V2 -> Graphiti MCP).
  // Установлен в образ по пути /opt/graphiti-extractor; читает GRAPHITI_URL и
  // GRAPHITI_GROUP_ID из окружения. Захват идёт в фоне, без инъекции в контекст.
  "plugins": ["/opt/graphiti-extractor"],

  "mcp": {
    "servers": {
      "graphiti": {
        "type": "remote",
        "url": "http://graphiti:8000/mcp",
        "oauth": false
      }
    }
  }
}
