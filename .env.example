# ============================================================
#  AI-ассистент  (OpenCode V2 + Telegram-бот + Graphiti/FalkorDB)
#  Файл создаёт мастер установки. НЕ коммитьте его в git.
#  Формат переменных совместим с grinev/opencode-telegram-bot (MIT).
# ============================================================

# --- Telegram (обязательно) ---
# Токен от @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Ваш числовой Telegram ID (от @userinfobot). Бот однопользовательский.
TELEGRAM_ALLOWED_USER_ID=
# Язык интерфейса бота: ru | en | de | es | fr | ...
BOT_LOCALE=ru

# --- OpenCode Server V2 ---
OPENCODE_SERVER_VERSION=v2
OPENCODE_API_URL=http://opencode:49374
OPENCODE_SERVER_USERNAME=opencode
# Пароль к серверу. Генерируется мастером, общий для сервисов.
OPENCODE_SERVER_PASSWORD=

# --- Модель OpenCode ---
OPENCODE_MODEL_PROVIDER=openai
OPENCODE_MODEL_ID=gpt-4o-mini
# Дешёвая модель для сводок компакции (не для ответов). Пусто — модель сессии.
# Формат: provider/model, например openai/gpt-4o-mini, openrouter/openai/gpt-4o-mini,
# anthropic/claude-3-5-haiku-latest.
OPENCODE_SMALL_MODEL=openai/gpt-4o-mini
# Какой конфиг монтировать в контейнер: opencode.jsonc — штатный,
# opencode.local.jsonc — сгенерированный мастером для Ollama/своего endpoint.
OPENCODE_CONFIG_FILE=opencode.jsonc

# --- Ключи провайдеров (читает OpenCode) ---
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# Свой OpenAI-совместимый endpoint (мастер установки, пункт «Свой вариант»):
# CUSTOM_API_KEY=
# Ollama ключ не нужен; адрес задаётся в opencode.local.jsonc
# (по умолчанию http://host.docker.internal:11434/v1).

# --- Google Developers API (общий ключ) ---
# Ключ из Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Нужен агенту, чтобы самому ходить в Google API (поиск, YouTube и т.п.).
# Конкретные API включаются отдельно в Cloud Console. Пусто — без них.
GOOGLE_API_KEY=

# --- Режим самоподдержки (docker-compose.selfhost.yml, docs/self-support.md) ---
# 1 — агент из контейнера управляет Docker хоста и видит папку хоста в /host;
# deploy.sh подключит selfhost-override автоматически. Осторожно: это близко к root.
SELFHOST=0
# Папка хоста, монтируемая в /host (Windows — прямые слэши; C:/ — весь диск):
HOST_FS_DIR=
# Graphiti использует OPENAI_API_KEY для извлечения/эмбеддингов/реранкера.
# Если ходите через прокси/совместимый endpoint — задайте базовый URL.
# OPENAI_BASE_URL понимает OpenCode; Graphiti читает OPENAI_API_URL (compose
# подставляет его из OPENAI_BASE_URL, если отдельно не задан):
# OPENAI_API_URL=
# OPENAI_BASE_URL=

# --- Голос: Whisper-совместимый STT (необязательно) ---
# Если задать STT_API_URL и STT_API_KEY, бот принимает голосовые.
# По умолчанию — Groq: быстро и есть бесплатный тариф
# (ключ: https://console.groq.com/keys).
STT_API_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=ru
# Вместо Groq можно OpenAI (ключ — OPENAI_API_KEY):
# STT_API_URL=https://api.openai.com/v1
# STT_MODEL=whisper-1

# --- Озвучка ответов TTS (необязательно) ---
# TTS_PROVIDER=openai
# TTS_API_URL=https://api.openai.com/v1
# TTS_API_KEY=
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy

# --- Память: Graphiti + FalkorDB ---
# Профиль compose: "memory" включает Graphiti+FalkorDB. Пусто — работаем без памяти.
COMPOSE_PROFILES=memory
FALKORDB_PASSWORD=
# Куда фоновый экстрактор пишет эпизоды и в какую группу графа.
GRAPHITI_URL=http://graphiti:8000/mcp?codemode=false
GRAPHITI_GROUP_ID=main
GRAPHITI_IMAGE=ghcr.io/your-github-user/ai-assistant-graphiti:latest
FALKORDB_IMAGE=falkordb/falkordb:latest

# --- Экономия токенов (docs/token-budget.md) ---
# Graphiti извлекает сущности LLM-ом без prompt cache: каждый символ эпизода
# оплачивается полностью. Дешёвая модель + короткие эпизоды + батчи.
GRAPHITI_MODEL=gpt-4o-mini
# GRAPHITI_EMBEDDER_MODEL=text-embedding-3-small
# Сколько эпизодов обрабатывать параллельно (1–2 для Tier 1, 2–4 для Tier 2).
GRAPHITI_SEMAPHORE_LIMIT=2
# Пауза простоя перед отправкой батча; больше пауза — меньше эпизодов.
GRAPHITI_DEBOUNCE_MS=180000
# Минимум реплик и символов, иначе батч пропускается.
GRAPHITI_MIN_TURNS=4
GRAPHITI_MIN_CHARS=400
# Лимиты на эпизод и на одну реплику (пользователь / ассистент).
GRAPHITI_MAX_CHARS=12000
GRAPHITI_PER_TURN_MAX=900
GRAPHITI_ASSISTANT_MAX=400
# Отбрасывать «ок», «спасибо», команды, эмодзи.
GRAPHITI_MIN_TURN_CHARS=16
# GRAPHITI_SKIP_LOW_VALUE=true
# Сколько фактов/узлов возвращает memory(search) и лимит ответа.
GRAPHITI_SEARCH_TOP_K=5
GRAPHITI_SEARCH_MAX_CHARS=2000
# Доп. указание для извлечения (необязательно), например:
# GRAPHITI_EXTRACTION_INSTRUCTIONS=Extract durable user facts, preferences and decisions. Ignore small talk.

# --- Docker-образы ---
# Локальная сборка (install.sh собирает их через --build):
OPENCODE_IMAGE=opencode-v2:local
BOT_IMAGE=opencode-telegram-bot:local
# Для VPS с готовыми образами из GHCR (их собирает CI) раскомментируйте и
# подставьте свой GitHub-логин:
# OPENCODE_IMAGE=ghcr.io/your-github-user/ai-assistant-opencode:latest
# BOT_IMAGE=ghcr.io/your-github-user/ai-assistant-bot:latest

# --- Прочее ---
TZ=Europe/Moscow
LOG_LEVEL=info
