# systemd-юнит для AI-ассистента (Docker Compose).
#
# 1. Скопируйте в /etc/systemd/system/ :
#      sudo cp systemd/ai-assistant.service /etc/systemd/system/
# 2. Впишите свой путь в WorkingDirectory (ниже).
# 3. Включите и запустите:
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now ai-assistant
#      sudo systemctl status ai-assistant
#
# Примечание: у сервисов в compose уже стоит restart: unless-stopped и Docker
# поднимается при загрузке, так что юнит в основном формализует управление
# проектом. Убедитесь, что Docker включён: sudo systemctl enable docker

[Unit]
Description=AI Assistant (OpenCode V2 + Telegram bot) via Docker Compose
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# УКАЖИТЕ СВОЙ ПУТЬ до каталога с docker-compose.yml:
WorkingDirectory=/opt/ai-assistant
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose restart
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
